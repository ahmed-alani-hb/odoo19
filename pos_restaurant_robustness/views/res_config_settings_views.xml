<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_close_table" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.close.table</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='iface_orderline_notes']" position="after">
                <setting string="Close Table After Sending"
                         help="Return to the floor screen after an order is sent. Disable to keep the table open for adding more items."
                         id="close_table_after_order"
                         invisible="not pos_module_pos_restaurant">
                    <field name="pos_close_table_after_order"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
