<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <!-- Persistent, unmissable alert bar for kitchen tickets that failed or could
         not be confirmed. Injected once at the POS root (between the navbar and the
         screen content) so it shows on every screen and pushes content down rather
         than overlaying it. Driven entirely by `pos` helpers (no extra component) and
         guarded so it can never break the chrome. In-flight "pending" sends are
         excluded by getKitchenAlerts(). -->
    <t t-name="point_of_sale.Chrome" t-inherit="point_of_sale.Chrome" t-inherit-mode="extension">
        <xpath expr="//Navbar" position="after">
            <t t-set="kitchenAlerts" t-value="this.pos.getKitchenAlerts()"/>
            <div t-if="kitchenAlerts.length"
                 class="o_kitchen_alert_banner d-flex flex-column flex-shrink-0 bg-danger text-white z-3">
                <div t-foreach="kitchenAlerts" t-as="alert" t-key="alert.entryId"
                     class="d-flex align-items-center justify-content-between gap-2 px-3 py-1 border-bottom border-light border-opacity-25">
                    <div class="d-flex align-items-center gap-2 text-truncate">
                        <i class="fa fa-exclamation-triangle flex-shrink-0" role="img" aria-label="Kitchen print alert"/>
                        <span class="fw-bolder text-truncate">
                            <t t-if="alert.table">Table <t t-esc="alert.table"/> — </t>
                            <t t-esc="alert.printers"/>
                        </span>
                        <span class="text-truncate opacity-75" t-esc="alert.reason"/>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <button class="btn btn-sm btn-light" t-on-click="() => this.pos.openKitchenAlert(alert)">
                            Open
                        </button>
                        <button class="btn btn-sm btn-outline-light" t-on-click="() => this.pos.clearFailedPrint(alert.order, alert.entryId)">
                            Dismiss
                        </button>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
