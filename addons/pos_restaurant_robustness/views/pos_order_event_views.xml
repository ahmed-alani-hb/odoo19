<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_order_event_list" model="ir.ui.view">
        <field name="name">pos.order.event.list</field>
        <field name="model">pos.order.event</field>
        <field name="arch" type="xml">
            <list string="POS Kitchen Diagnostics" create="false"
                  default_order="event_date desc"
                  decoration-danger="severity == 'error'"
                  decoration-warning="severity == 'warning'">
                <field name="event_date"/>
                <field name="event_type"/>
                <field name="severity"/>
                <field name="source"/>
                <field name="config_id" optional="show"/>
                <field name="session_id" optional="hide"/>
                <field name="table_id" optional="show"/>
                <field name="order_uuid" optional="hide"/>
                <field name="pos_reference" optional="show"/>
                <field name="device_identifier" optional="show"/>
                <field name="printer_name" optional="show"/>
                <field name="cashier" optional="hide"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_pos_order_event_form" model="ir.ui.view">
        <field name="name">pos.order.event.form</field>
        <field name="model">pos.order.event</field>
        <field name="arch" type="xml">
            <form string="POS Event" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="severity"/>
                            <field name="source"/>
                            <field name="event_date"/>
                            <field name="device_identifier"/>
                            <field name="printer_name"/>
                            <field name="cashier"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="table_id"/>
                            <field name="order_id"/>
                            <field name="order_uuid"/>
                            <field name="pos_reference"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Details (JSON)">
                        <field name="payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_order_event_search" model="ir.ui.view">
        <field name="name">pos.order.event.search</field>
        <field name="model">pos.order.event</field>
        <field name="arch" type="xml">
            <search string="POS Kitchen Diagnostics">
                <field name="order_uuid"/>
                <field name="pos_reference"/>
                <field name="device_identifier"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="table_id"/>
                <filter name="errors" string="Errors" domain="[('severity', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('severity', '=', 'warning')]"/>
                <separator/>
                <filter name="printing" string="Printing Events"
                        domain="[('event_type', 'in', ('kitchen_send_attempt', 'kitchen_print_ok', 'kitchen_print_partial', 'kitchen_print_fail', 'kitchen_print_retry', 'mark_sent_skipped', 'double_send_blocked'))]"/>
                <filter name="concurrency" string="Concurrency Events"
                        domain="[('event_type', 'in', ('sync_table_match_diff_order', 'order_lines_overwritten', 'order_consolidated', 'prep_change_conflict'))]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('event_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_7_days" string="Last 7 Days"
                        domain="[('event_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                    <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
                    <filter name="group_table" string="Table" context="{'group_by': 'table_id'}"/>
                    <filter name="group_device" string="Device" context="{'group_by': 'device_identifier'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'event_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pos_order_event_pivot" model="ir.ui.view">
        <field name="name">pos.order.event.pivot</field>
        <field name="model">pos.order.event</field>
        <field name="arch" type="xml">
            <pivot string="POS Kitchen Diagnostics">
                <field name="event_type" type="row"/>
                <field name="event_date" interval="hour" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_order_event_graph" model="ir.ui.view">
        <field name="name">pos.order.event.graph</field>
        <field name="model">pos.order.event</field>
        <field name="arch" type="xml">
            <graph string="POS Kitchen Diagnostics" type="bar">
                <field name="event_date" interval="hour"/>
                <field name="event_type"/>
            </graph>
        </field>
    </record>

    <record id="action_pos_order_event" model="ir.actions.act_window">
        <field name="name">Kitchen Diagnostics</field>
        <field name="res_model">pos.order.event</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_last_7_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No POS events recorded yet</p>
            <p>
                This log records kitchen-printing and order-sync events from the Point of Sale,
                so you can verify stability and diagnose missed/duplicate tickets and
                multi-employee table conflicts. Use the pivot/graph (event type by hour) to
                spot rush-hour spikes.
            </p>
        </field>
    </record>

</odoo>
